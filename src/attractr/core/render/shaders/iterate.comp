#version 430
//__PRECISION__
// ── Attractr iteration kernel (GL 4.3 compute) ───────────────────────────────────
// One invocation = one trajectory.  Accumulates ``u_steps`` points into fixed-point
// uint images (merged into float accumulators by merge.comp after every pass).
layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer State  { real4 st[]; };    // x, y, z, t_step (float or double)
layout(std430, binding = 1) buffer Rng    { uint rng_state[]; };
layout(std430, binding = 2) buffer Prev   { vec4 prev[]; };   // u, v, cv, have(>0)
layout(std430, binding = 3) buffer PrevD  { vec4 prevd[]; };  // previous step delta (curvature)
layout(std430, binding = 4) buffer Stats  { uint restarts; uint plotted_lo; uint plotted_hi; uint pad; };

layout(r32ui, binding = 0) uniform uimage2D img_count;
layout(r32ui, binding = 1) uniform uimage2D img_depth;
layout(r32ui, binding = 2) uniform uimage2D img_zmin;
layout(r32ui, binding = 3) uniform uimage2D img_cv;

uniform int   u_steps;
uniform int   u_substeps;
uniform float u_dt;
uniform mat3  u_R;
uniform vec3  u_center;
uniform float u_inv_radius;
uniform vec2  u_c;          // cx, cy (already includes tile offset)
uniform float u_focal;
uniform float u_persp;
uniform ivec2 u_size;       // accumulation buffer size (tile)
uniform int   u_splat_r;
uniform float u_kern[81];
uniform int   u_gap_fill;
uniform int   u_color_code;
uniform ivec4 u_flags;      // want_depth, want_zmin, want_color, do_plot
uniform vec3  u_ic;
uniform float u_jitter;
uniform float u_inv_n;
uniform vec2  u_cv_range;   // lo, 1/(hi-lo) — colour value fixed-point encoding range
uniform float u_p[__NPARAMS__];

const float FIXED = 256.0;          // 24.8 fixed point for count / depth / cv sums
const float DIVERGE_LIMIT = 1.0e6;

//__PRELUDE__
//__STEP__

uint _zkey(float z) {               // monotonic float → uint mapping for atomicMin
    uint k = floatBitsToUint(z);
    return (k & 0x80000000u) != 0u ? ~k : (k | 0x80000000u);
}

void deposit(ivec2 pix, float w, float depth, float cv) {
    imageAtomicAdd(img_count, pix, uint(w * FIXED + 0.5));
    if (u_flags.x != 0) imageAtomicAdd(img_depth, pix, uint(w * (clamp(depth, -2.0, 2.0) * 0.25 + 0.5) * FIXED + 0.5));
    if (u_flags.y != 0) imageAtomicMin(img_zmin, pix, _zkey(depth));
    if (u_flags.z != 0) imageAtomicAdd(img_cv, pix, uint(w * clamp((cv - u_cv_range.x) * u_cv_range.y, 0.0, 1.0) * FIXED + 0.5));
}

float splat(float u, float v, float w, float depth, float cv) {
    float landed = 0.0;
    if (u_splat_r == 0) {
        float gx = u - 0.5, gy = v - 0.5;
        int x0 = int(floor(gx)), y0 = int(floor(gy));
        float fx = gx - float(x0), fy = gy - float(y0);
        for (int j = 0; j < 2; j++) {
            int yy = y0 + j; if (yy < 0 || yy >= u_size.y) continue;
            float wy = (j == 1) ? fy : 1.0 - fy;
            for (int i = 0; i < 2; i++) {
                int xx = x0 + i; if (xx < 0 || xx >= u_size.x) continue;
                float wx = (i == 1) ? fx : 1.0 - fx;
                float ww = w * wx * wy;
                deposit(ivec2(xx, yy), ww, depth, cv); landed += ww;
            }
        }
    } else {
        int ix = int(floor(u)), iy = int(floor(v)), r = u_splat_r, kn = 2 * r + 1;
        for (int dy = -r; dy <= r; dy++) {
            int yy = iy + dy; if (yy < 0 || yy >= u_size.y) continue;
            for (int dx = -r; dx <= r; dx++) {
                int xx = ix + dx; if (xx < 0 || xx >= u_size.x) continue;
                float k = u_kern[(dy + r) * kn + (dx + r)]; if (k == 0.0) continue;
                deposit(ivec2(xx, yy), w * k, depth, cv); landed += w * k;
            }
        }
    }
    return landed;
}

float color_value(float qx, float qy, float qz, float speed, float radius, float curv, float idx, real x, real y, real z) {
    switch (u_color_code) {
        case 1: return qx;  case 2: return qy;  case 3: return qz;  case 4: return qz;
        case 5: return speed; case 6: return radius; case 7: return idx; case 8: return curv;
        case 9: return float(color_fn(x, y, z));
    }
    return 0.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= st.length()) return;
    real4 s = st[i];
    real x = s.x, y = s.y, z = s.z, tstep = s.w;
    real dt = R(u_dt);
    uint rng = rng_state[i];
    vec4 pv = prev[i];
    vec4 pd = prevd[i];
    float plotted = 0.0;
    bool want_color = u_flags.z != 0;

    for (int n = 0; n < u_steps; n++) {
        real ox = x, oy = y, oz = z;
        for (int k = 0; k < u_substeps; k++) { step(x, y, z, rng, tstep, dt); tstep += R(1.0); }
        if (isnan(x) || isnan(y) || isnan(z) || isinf(x) || isinf(y) || isinf(z)
            || abs(x) > R(DIVERGE_LIMIT) || abs(y) > R(DIVERGE_LIMIT) || abs(z) > R(DIVERGE_LIMIT)) {
            x = R(u_ic.x) + (_rand(rng) - R(0.5)) * R(u_jitter);
            y = R(u_ic.y) + (_rand(rng) - R(0.5)) * R(u_jitter);
            z = R(u_ic.z) + (_rand(rng) - R(0.5)) * R(u_jitter);
            atomicAdd(restarts, 1u);
            pv.w = 0.0;
            continue;
        }
        if (u_flags.w == 0) continue;
        vec3 q = u_R * vec3((real3(x, y, z) - real3(u_center)) * R(u_inv_radius));
        float d = max(1.0 + u_persp * q.z, 0.05);
        float u = u_c.x + u_focal * q.x / d;
        float v = u_c.y - u_focal * q.y / d;
        if (!(u > -1.0e6 && u < 1.0e6 && v > -1.0e6 && v < 1.0e6)) { pv.w = 0.0; continue; }
        float cv = 0.0;
        if (want_color) {
            vec3 dd = vec3(real3(x - ox, y - oy, z - oz));
            float speed = length(dd) * u_inv_radius;
            float curv = 0.5;
            if (u_color_code == 8) {
                float la = length(dd), lb = length(pd.xyz);
                if (la > 1e-12 && lb > 1e-12) curv = 0.5 * (1.0 - clamp(dot(dd, pd.xyz) / (la * lb), -1.0, 1.0));
                pd.xyz = dd;
            }
            cv = color_value(q.x, q.y, q.z, speed, length(q), curv, float(i) * u_inv_n, x, y, z);
        }
        int nseg = 1;
        if (u_gap_fill != 0 && pv.w > 0.0) {
            float dist = distance(vec2(u, v), pv.xy);
            if (dist > 1.0 && dist < float(u_size.x + u_size.y)) nseg = min(int(ceil(dist)), 64);
        }
        float wseg = 1.0 / float(nseg);
        for (int j = 1; j <= nseg; j++) {
            float f = float(j) * wseg;
            float uu = (nseg > 1) ? mix(pv.x, u, f) : u;
            float vv = (nseg > 1) ? mix(pv.y, v, f) : v;
            float cc = (nseg > 1) ? mix(pv.z, cv, f) : cv;
            plotted += splat(uu, vv, wseg, q.z, cc);
        }
        pv = vec4(u, v, cv, 1.0);
    }
    st[i] = real4(x, y, z, tstep);
    rng_state[i] = rng;
    prev[i] = pv;
    prevd[i] = pd;
    // 64-bit-ish accumulation of plotted weight: lo in 1/16 units, carry into hi
    uint add = uint(plotted * 16.0 + 0.5);
    uint old = atomicAdd(plotted_lo, add);
    if (old + add < old) atomicAdd(plotted_hi, 1u);
}
