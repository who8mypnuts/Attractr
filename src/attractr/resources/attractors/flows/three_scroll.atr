name: Three-scroll unified
family: Flows
desc: The three-scroll unified chaotic system (TSUCS) — three nested scrolls.
ref: L. Pan, D. Xu & W. Zhou, Int. J. Bifurcation Chaos (2010)
tags: flow, 3d
dt: 0.0005
ic: 0.1 0.1 0.1
camera: 25 20 0 1

param a = 40 [30, 50]
param b = 0.833 [0.5, 1.2]
param c = 20 [10, 30]
param d = 0.5 [0, 1]
param e = 0.65 [0, 1]

dx = a*(y - x) + d*x*z
dy = c*y - x*z
dz = b*z + x*y - e*x^2
