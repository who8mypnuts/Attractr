name: Yu-Wang
family: Flows
desc: A system with an exponential nonlinearity — a fat, butterfly-like attractor.
ref: F. Yu & C. Wang, Eng. Technol. Appl. Sci. Res. (2012)
tags: flow, 3d
dt: 0.002
ic: 0.1 0.1 20
camera: 25 20 0 1

param a = 10 [5, 15]
param b = 40 [30, 50]
param c = 2 [1, 3]
param d = 2.5 [1.5, 3.5]

dx = a*(y - x)
dy = b*x - c*x*z
dz = exp(x*y) - d*z
