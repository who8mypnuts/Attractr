name: Rikitake
family: Flows
desc: The two-disc dynamo model of geomagnetic reversals.
ref: T. Rikitake, Proc. Cambridge Phil. Soc. 54 (1958)
tags: flow, 3d
dt: 0.02
ic: 0.1 0.1 0.1
camera: 25 20 0 1

param mu = 2.0 [1, 3] "μ — dissipation."
param a = 5.0 [3, 7] "Difference of the angular velocities."

dx = -mu*x + y*z
dy = -mu*y + (z - a)*x
dz = 1 - x*y
