name: Tinkerbell
family: Maps
desc: The Tinkerbell map — a fairy-wing shaped attractor from a quadratic recurrence.
ref: https://en.wikipedia.org/wiki/Tinkerbell_map
tags: map, 2d
dims: 2
ic: -0.72 -0.64 0
jitter: 0.01
warmup: 200

param a = 0.9 [-1, 1]
param b = -0.6013 [-1, 1]
param c = 2.0 [0, 3]
param d = 0.5 [-1, 1]

x' = x^2 - y^2 + a*x + b*y
y' = 2*x*y + c*x + d*y
